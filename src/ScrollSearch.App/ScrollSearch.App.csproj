<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScrollScreenSearch</AssemblyName>
    <RootNamespace>ScrollSearch.App</RootNamespace>
    <Version>1.0.0</Version>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- WPF owns DPI awareness via the manifest; WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ScrollSearch.Core/ScrollSearch.Core.csproj" /></ItemGroup>
</Project>
